    {
        "id": "8ddee661d2ebdf0f",
        "type": "function",
        "z": "fh-flow-1",
        "name": "--",
        "func": "/**\n * Transforms a labeled Bluesky post into a UI list item.\n */\nfunction postToListItem(post) {\n  const qualityScore = post.cdr_summary?.overall_quality_score ?? 0;\n\n  const nutricionResumen = Object.entries(post.nutricion || {})\n    .map(([key, val]) => `${key}: ${val.valor} (${val.cdr_porcentaje}%)`)\n    .join(', ');\n\n  const iconByScore = qualityScore >= 70 ? '🟢'\n    : qualityScore >= 40 ? '🟡'\n    : '🔴';\n\n  return {\n    title: post.text?.split('\\n')[0]?.slice(0, 80) || post.rkey,\n    description: nutricionResumen || undefined,\n    menu: [\n      { label: 'Fichero', value: msg.filepath },\n      { label: 'Datos', value: {...msg.payload} },\n    ],\n    icon_unicode: iconByScore,\n    isChecked: qualityScore >= 50,\n  };\n}\n\nconst list = flow.get(\"LABELED\") || [];\n\nlist.push(postToListItem(msg.payload));\nmsg.payload = list;\nflow.set(\"LABELED\", list)\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
