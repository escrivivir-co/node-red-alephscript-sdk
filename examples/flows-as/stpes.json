    {
        "id": "7595af1a9e5273c5",
        "type": "function",
        "z": "fh-flow-1",
        "name": "Candiate Record 2 List",
        "func": "/**\n * Transforms a raw Bluesky firehose commit event into a UI list item.\n */\nfunction firehoseEventToListItem(event) {\n  const record = event.commit?.record || {};\n  const isReply = !!record.reply;\n  const lang = (record.langs || [])[0] || '??';\n\n  return {\n    title: record.text?.slice(0, 50) || event.commit?.rkey,\n    description: record.text?.length > 50 ? ('...' + record.text.slice(50, 200)) : undefined,\n    menu: [\n      { label: 'Etiquetar', value: {...msg.payload} }\n    ].filter(item => item.value),\n    icon_unicode: isReply ? '💬' : '📝',\n    isChecked: false,\n  };\n}\n\nconst gLIST = \"CANDIDATES_LIST\"\nconst list = flow.get(gLIST) || [];\n\nmsg.payload.rawFile = msg.filepath;\nlist.push(firehoseEventToListItem(msg.payload));\nmsg.payload = list.reverse();\nflow.set(gLIST, list)\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 260,
        "wires": [
            [
                "f3136a27d419a7a0"
            ]
        ]
