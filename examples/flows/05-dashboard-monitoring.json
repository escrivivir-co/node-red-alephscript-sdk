    {
        "id": "bot-status-processor",
        "type": "function",
        "z": "f5",
        "name": "Bot Status Analytics",
        "func": "// Process bot registry data for dashboard\nconst bots = msg.payload.bots || [];\nconst stats = {\n    totalBots: bots.length,\n    onlineBots: bots.filter(bot => bot.status === 'online').length,\n    offlineBots: bots.filter(bot => bot.status === 'offline').length,\n    rooms: [...new Set(bots.map(bot => bot.room).filter(Boolean))],\n    lastUpdate: new Date().toISOString()\n};\n\nstats.uptime = stats.totalBots > 0 ? \n    Math.round((stats.onlineBots / stats.totalBots) * 100) : 0;\n\nmsg.dashboard = {\n    type: 'bot-stats',\n    data: stats,\n    bots: bots\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 100,
        "wires": [
            ["ui-bot-chart"]
        ]
    },
    {
        "id": "room-stats-processor",
        "type": "function",
        "z": "f5",
        "name": "Room Statistics",
        "func": "// Process room data for dashboard\nconst payload = msg.payload;\nconst roomStats = context.get('roomStats') || {};\n\nif (payload.type === 'room_activity') {\n    const room = payload.room;\n    if (!roomStats[room]) {\n        roomStats[room] = {\n            messageCount: 0,\n            lastActivity: null,\n            participants: new Set()\n        };\n    }\n    \n    roomStats[room].messageCount++;\n    roomStats[room].lastActivity = new Date().toISOString();\n    \n    if (payload.bot) {\n        roomStats[room].participants.add(payload.bot);\n    }\n}\n\ncontext.set('roomStats', roomStats);\n\n// Convert Set to Array for JSON serialization\nconst processedStats = {};\nObject.keys(roomStats).forEach(room => {\n    processedStats[room] = {\n        ...roomStats[room],\n        participants: Array.from(roomStats[room].participants)\n    };\n});\n\nmsg.dashboard = {\n    type: 'room-stats',\n    data: processedStats,\n    totalRooms: Object.keys(processedStats).length\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 160,
        "wires": [
            ["ui-room-chart"]
        ]
    },
    {
        "id": "stream-analytics",
        "type": "function",
        "z": "f5",
        "name": "Stream Analytics",
        "func": "// Analyze message streams for dashboard\nconst analytics = context.get('analytics') || {\n    messagesPerMinute: 0,\n    channelDistribution: { app: 0, sys: 0, ui: 0 },\n    errorRate: 0,\n    peakHours: {},\n    lastReset: new Date().toISOString()\n};\n\nconst payload = msg.payload;\nconst currentHour = new Date().getHours();\n\n// Update analytics\nanalyticsมessagesPerMinute++;\n\nif (payload.channel) {\n    analytics.channelDistribution[payload.channel]++;\n}\n\nif (payload.type === 'error') {\n    analytics.errorRate++;\n}\n\nanalytics.peakHours[currentHour] = (analytics.peakHours[currentHour] || 0) + 1;\n\n// Reset counters every minute\nconst now = new Date();\nconst lastReset = new Date(analytics.lastReset);\nif (now.getTime() - lastReset.getTime() > 60000) {\n    analytics.messagesPerMinute = 0;\n    analytics.lastReset = now.toISOString();\n}\n\ncontext.set('analytics', analytics);\n\nmsg.dashboard = {\n    type: 'stream-analytics',\n    data: analytics\n};\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 220,
        "wires": [
            ["ui-stream-chart"]
        ]
    },
