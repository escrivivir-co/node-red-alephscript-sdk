    {
        "id": "inject-app",
        "type": "inject",
        "z": "f2",
        "name": "App State Change",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{\"action\":\"set_state\",\"state\":\"running\",\"data\":{\"progress\":50}}",
        "payloadType": "json",
        "x": 160,
        "y": 220,
        "wires": [
            ["app-channel1"]
        ]
    },
    {
        "id": "inject-sys",
        "type": "inject",
        "z": "f2",
        "name": "System Health Check",
        "props": [
            {
                "p": "payload"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{\"type\":\"health_check\",\"cpu\":45,\"memory\":68,\"status\":\"healthy\"}",
        "payloadType": "json",
        "x": 170,
        "y": 260,
        "wires": [
            ["sys-channel1"]
        ]
    },
    {
        "id": "inject-ui",
        "type": "inject",
