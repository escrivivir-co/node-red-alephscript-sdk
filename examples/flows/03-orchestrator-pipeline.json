    {
        "id": "route-processor",
        "type": "function",
        "z": "f3",
        "name": "Route Processor",
        "func": "// Process routed messages\nconst channel = msg.channel || 'unknown';\nconst payload = msg.payload;\n\n// Add routing metadata\nmsg.routing = {\n    originalChannel: channel,\n    processedAt: new Date().toISOString(),\n    routingId: Math.random().toString(36).substr(2, 9)\n};\n\n// Route based on message type\nif (payload.type === 'error') {\n    msg.targetChannel = 'sys';\n    msg.priority = 'high';\n} else if (payload.type === 'status_update') {\n    msg.targetChannel = 'ui';\n    msg.priority = 'medium';\n} else {\n    msg.targetChannel = 'app';\n    msg.priority = 'low';\n}\n\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 200,
        "wires": [
            ["switch-router"]
        ]
    },
    {
        "id": "switch-router",
        "type": "switch",
        "z": "f3",
        "name": "Channel Router",
        "property": "targetChannel",
        "propertyType": "msg",
        "rules": [
            {
                "t": "eq",
                "v": "app",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "sys",
                "vt": "str"
            },
            {
                "t": "eq",
                "v": "ui",
                "vt": "str"
            }
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 3,
        "x": 780,
        "y": 200,
        "wires": [
            ["debug-app-route"],
            ["debug-sys-route"],
            ["debug-ui-route"]
        ]
    },
