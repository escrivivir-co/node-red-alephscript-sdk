    {
        "id": "metrics-collector",
        "type": "function",
        "z": "f3",
        "name": "Pipeline Metrics",
        "func": "// Collect pipeline metrics\nconst metrics = context.get('metrics') || {\n    totalMessages: 0,\n    channelCounts: { app: 0, sys: 0, ui: 0 },\n    errorCount: 0,\n    lastProcessed: null\n};\n\nmetrics.totalMessages++;\nmetrics.channelCounts[msg.channel] = (metrics.channelCounts[msg.channel] || 0) + 1;\n\nif (msg.payload.type === 'error') {\n    metrics.errorCount++;\n}\n\nmetrics.lastProcessed = new Date().toISOString();\ncontext.set('metrics', metrics);\n\nmsg.metrics = metrics;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 380,
