{
  "name": "node-red-dashboard-2-alephscript-escribiente",
  "version": "0.1.0",
  "description": "Node-RED contrib nodes and Dashboard 2 widget for AlephScript Escribiente audio transcription workflows",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "resources/**/*",
    "ui/**/*",
    "vite.config.mjs"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc --build",
    "build:full": "npm run clean && npm run build && npm run copy:html && npm run build:ui",
    "build:ui": "vite build",
    "copy:html": "node scripts/postbuild.cjs",
    "dev": "npm run dev:ts & npm run watch:html",
    "dev:ts": "tsc --watch",
    "dev:ui": "vite build --watch",
    "watch:html": "echo 'HTML watch not implemented - copy manually after changes'",
    "test": "echo 'No tests yet for Escribiente'",
    "lint": "eslint src --ext .ts",
    "clean": "node -e \"const fs=require('fs'); ['dist','resources'].forEach((dir)=>{ if(fs.existsSync(dir)) fs.rmSync(dir, {recursive:true}); }); if(fs.existsSync('tsconfig.tsbuildinfo')) fs.rmSync('tsconfig.tsbuildinfo'); console.log('🧹 Cleaned dist/ and resources/')\"",
    "prepublishOnly": "npm run build:full"
  },
  "keywords": [
    "node-red",
    "node-red-dashboard-2",
    "alephscript",
    "escribiente",
    "whisper",
    "transcription",
    "dashboard"
  ],
  "node-red": {
    "nodes": {
      "alephscript-escribiente-config": "dist/nodes/escribiente-config.js",
      "alephscript-escribiente-precheck": "dist/nodes/escribiente-precheck.js",
      "alephscript-escribiente-session": "dist/nodes/escribiente-session.js",
      "alephscript-escribiente-chunker": "dist/nodes/escribiente-chunker.js",
      "alephscript-escribiente-transcriber": "dist/nodes/escribiente-transcriber.js",
      "alephscript-escribiente-session-closer": "dist/nodes/escribiente-session-closer.js",
      "alephscript-escribiente-dashboard-recorder": "dist/nodes/escribiente-dashboard-recorder.js"
    }
  },
  "node-red-dashboard-2": {
    "version": "1.0.0",
    "widgets": {
      "alephscript-escribiente-dashboard-recorder": {
        "output": "escribiente-dashboard-recorder.umd.js",
        "component": "EscribienteDashboardRecorder"
      }
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/node-red": "^1.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.17",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vue": "^3.5.13"
  },
  "peerDependencies": {
    "node-red": ">=3.0.0"
  },
  "license": "MIT"
}
