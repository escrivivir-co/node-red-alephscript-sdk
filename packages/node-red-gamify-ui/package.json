{
  "name": "node-red-gamify-ui",
  "version": "0.1.0",
  "description": "Angular UI application for Node-RED management with AlephScript integration",
  "main": "dist/index.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build node-red-gamify-ui",
