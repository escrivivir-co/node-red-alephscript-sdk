{
  "name": "node-red-contrib-alephscript",
  "version": "0.1.0",
  "description": "Node-RED contrib nodes for AlephScript ecosystem integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc --build",
    "build:full": "npm run clean && npm run build && npm run copy:html",
    "copy:html": "node scripts/postbuild.cjs",
    "dev": "npm run dev:ts & npm run watch:html",
    "dev:ts": "tsc --watch",
    "watch:html": "echo 'HTML watch not implemented - copy manually after changes'",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive:true}); console.log('🧹 Cleaned dist/')\"",
    "prepublishOnly": "npm run build:full"
  },
  "keywords": [
    "node-red",
    "alephscript",
    "socket.io",
    "orchestration",
    "channel-agents"
  ],
  "node-red": {
    "nodes": {
      "alephscript-bot": "dist/nodes/bot-node.js",
      "alephscript-enhanced-bot": "dist/nodes/enhanced-bot-node.js",
      "alephscript-app-channel": "dist/nodes/app-channel-node.js",
      "alephscript-sys-channel": "dist/nodes/sys-channel-node.js",
      "alephscript-ui-channel": "dist/nodes/ui-channel-node.js",
      "alephscript-orchestrator": "dist/nodes/orchestrator-node.js",
      "alephscript-app-format": "dist/nodes/app-format-node.js",
      "alephscript-sys-format": "dist/nodes/sys-format-node.js",
      "alephscript-ui-format": "dist/nodes/ui-format-node.js",
      "alephscript-config": "dist/nodes/alephscript-config.js",
      "alephscript-bot-registry": "dist/nodes/alephscript-bot-registry.js",
      "alephscript-room-tester": "dist/nodes/alephscript-room-tester.js",
      "alephscript-stream-monitor": "dist/nodes/alephscript-stream-monitor.js"
    }
  },
  "dependencies": {
    "@alephscript/mcp-core-sdk": "file:../../../MCPGallery/mcp-core-sdk/alephscript-mcp-core-sdk-1.2.0.tgz",
    "rxjs": "^7.8.1",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/node-red": "^1.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "node-red": ">=3.0.0"
  },
  "license": "MIT"
}
