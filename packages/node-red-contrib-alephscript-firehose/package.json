{
  "name": "node-red-contrib-alephscript-firehose",
  "version": "0.1.0",
  "description": "Node-RED nodes for Bluesky AT Protocol firehose consumption with ONFALO CDR quality labeling",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc --build",
    "build:full": "npm run clean && npm run build && npm run copy:html",
    "copy:html": "node scripts/postbuild.cjs",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive:true}); console.log('Cleaned dist/')\"",
    "prepublishOnly": "npm run build:full"
  },
  "keywords": [
    "node-red",
    "alephscript",
    "bluesky",
    "firehose",
    "atproto",
    "onfalo",
    "cdr",
    "labeling"
  ],
  "node-red": {
    "nodes": {
      "firehose-config": "dist/nodes/firehose-config.js",
      "firehose-consumer": "dist/nodes/firehose-consumer.js",
      "firehose-filter": "dist/nodes/firehose-filter.js",
      "firehose-labeler": "dist/nodes/firehose-labeler.js",
      "firehose-file-out": "dist/nodes/firehose-file-out.js"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-red": "^1.3.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.3.2"
  },
  "peerDependencies": {
    "node-red": ">=3.0.0",
    "node-red-dashboard": ">=3.0.0"
  },
  "license": "MIT"
}
